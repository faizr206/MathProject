\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Interpretability via Subspace-to-Spectrum Inversion}{7}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Subspace-to-spectrum inversion (engine configuration): cross-class overlay of \emph  {PCA-filtered mean} spectra (project $\rightarrow $ invert $\rightarrow $ average), with reference-Hz normalization at 200\,Hz. Inline configurations concentrate slightly more energy in 0.8--3\,kHz, whereas V-configurations are rounder; single-cylinder shows the highest centroid due to stronger upper-band content.}}{9}{figure.caption.17}\protected@file@percent }
\newlabel{fig:inversion-plot}{{4}{9}{Subspace-to-spectrum inversion (engine configuration): cross-class overlay of \emph {PCA-filtered mean} spectra (project $\rightarrow $ invert $\rightarrow $ average), with reference-Hz normalization at 200\,Hz. Inline configurations concentrate slightly more energy in 0.8--3\,kHz, whereas V-configurations are rounder; single-cylinder shows the highest centroid due to stronger upper-band content}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-class comparison (V8): \emph  {data mean} (no PCA), \emph  {model mean} (invert mean MFCC once), and \emph  {PCA-filtered mean} (project $\rightarrow $ invert $\rightarrow $ average). The PCA-filtered mean better matches the envelope while suppressing out-of-subspace variance, motivating its use in the cross-class overlay.}}{9}{figure.caption.18}\protected@file@percent }
\newlabel{fig:inversion-bundle-v8}{{5}{9}{Per-class comparison (V8): \emph {data mean} (no PCA), \emph {model mean} (invert mean MFCC once), and \emph {PCA-filtered mean} (project $\rightarrow $ invert $\rightarrow $ average). The PCA-filtered mean better matches the envelope while suppressing out-of-subspace variance, motivating its use in the cross-class overlay}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Principal-direction excursions (Inline-4): PC1 behaves like a ``brightness'' control, shifting energy between low and high bands while preserving the overall envelope shape.}}{10}{figure.caption.19}\protected@file@percent }
\newlabel{fig:pc1-excursions-inline4}{{6}{10}{Principal-direction excursions (Inline-4): PC1 behaves like a ``brightness'' control, shifting energy between low and high bands while preserving the overall envelope shape}{figure.caption.19}{}}
